# Copy to .env and pick one.

# Local, no install needed: Postgres running in-process, stored in ./.pglite
DATABASE_URL=pglite:./.pglite

# Local Postgres you run yourself (Docker or native)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/vauditorium

# Neon (production / preview). The pooled URL for the app; the direct URL is
# used by migrations when set.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/vauditorium?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/vauditorium?sslmode=require

# Document storage. Unset in development: files go to ./.uploads.
# Production: a private Cloudflare R2 bucket (see docs/documents.md).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vauditorium-documents
